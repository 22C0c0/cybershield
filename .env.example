# CyberShield - Environment Configuration
# Copy this file to .env and fill in your values

# General
APP_NAME=cybershield
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cybershield
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_ALERTS=cybershield.alerts
KAFKA_TOPIC_LOGS=cybershield.logs

# NIDS
NIDS_INTERFACE=eth0
NIDS_PROMISCUOUS=true

# Vulnerability Scanner
VULN_SCANNER_MAX_THREADS=100
VULN_SCANNER_TIMEOUT=10

# Zero Trust Proxy
AUTH_PROXY_PORT=8443
JWT_SECRET=CHANGE_ME_JWT_SECRET
MFA_ISSUER=CyberShield

# Secrets Detector
SECRETS_SCAN_DEPTH=10
SECRETS_CUSTOM_RULES=true

# API Keys (optional - for enhanced threat intel)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
